[Unit]
Description=Telegram bot: AI models (test mode)
After=network-online.target
Wants=network-online.target

[Service]
User=modelsbot
WorkingDirectory=/opt/models-bot
# Зависимостей нет — системный Python, без venv
ExecStart=/usr/bin/python3 -m models_bot
Restart=always
RestartSec=5
# Меньше арен malloc: пул потоков DNS иначе раздувает память
Environment=MALLOC_ARENA_MAX=2 PYTHONUNBUFFERED=1
# Бот живёт в ~20 МБ, лимит — страховка от утечки
MemoryMax=96M
# /var/lib/models-bot: база пользователей, читать её может только сам бот
StateDirectory=models-bot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
