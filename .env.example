# Токен от @BotFather. Скопируйте этот файл в .env и заполните.
BOT_TOKEN=
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=
# Username поддержки без @
SUPPORT_USERNAME=
LOG_LEVEL=INFO
# Прокси, если api.telegram.org заблокирован: socks5://user:pass@host:port или http://host:port
PROXY=

# Сколько Telegram Stars брать за 1 доллар цены тарифа
STARS_PER_USD=77
SUBSCRIPTION_DAYS=30
REMIND_DAYS_BEFORE=3

DB_PATH=data/bot.db
API_BASE_URL=https://useitai.top/api/v1
# Публичная ссылка на документацию (docs/index.html). Пусто — кнопка в боте скрыта
DOCS_URL=

# Токен Crypto Pay: @CryptoBot → Crypto Pay → My Apps. Пусто — оплата криптой выключена
CRYPTO_PAY_TOKEN=
CRYPTO_INVOICE_MINUTES=60

# Собственный эндпоинт (клиенты получают ключи sk-us-... и этот адрес). Пусто — выключен
PUBLIC_API_URL=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8081

# Сайт запускается вместе с ботом
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8080
# true, когда сайт работает по HTTPS
WEB_SECURE_COOKIES=false
